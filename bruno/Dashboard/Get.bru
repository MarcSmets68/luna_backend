meta {
  name: Get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/web/dashboard
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.topKlanten: isArray
  res.body.topKlantenError: isBoolean
  res.body.topArtikelen: isArray
  res.body.topArtikelenError: isBoolean
  res.body.voorraadBewegingen.aantalIn: isNumber
  res.body.voorraadBewegingen.aantalUit: isNumber
  res.body.voorraadBewegingen.aantalArtikelen: isNumber
  res.body.voorraadBewegingen.topDalers: isArray
  res.body.voorraadBewegingenError: isBoolean
}

docs {
  Dashboard summary shown on the Luna homepage: stat cards, recent activity
  and open orders due this week ("productie deze week"). Aggregates
  offerte/bon/factuur/artikel - there is no dedicated activity-log or
  production-stage table in the schema. Read-only - backed by
  Backend/src/Luna/Web/DashboardHandler.cls + Luna/BusinessLogic/DashboardBE.cls.

  Response shape:
  {
    "statCards": {
      "openOffertesCount": n,
      "openOffertesBedragPotentieel": n,
      "ordersInProductieCount": n,
      "ordersInProductieLeverenDezeWeek": n,
      "omzetDezeMaand": n,
      "omzetVsVorigeMaandPct": n | null,
      "lageVoorraadCount": n
    },
    "recentActivity": [ { "text": "...", "datum": "YYYY-MM-DD", "type": "offerte" | "bon" | "factuur" } ],
    "productionThisWeek": [ { "bonnr": n, "klant": "...", "leverdatum": "YYYY-MM-DD", "bedrag": n, "geparkeerd": bool } ],
    "omzetTrend": [ { "month": n, "year": n, "label": "mmm YYYY", "total": n, "isPartial": bool } ],
    "topKlanten": [ { "rang": n, "klnr": n, "naam": "...", "omzet": n, "aantalFacturen": n, "aandeelPct": n, "omzetVorigeMaand": n, "vsVorigeMaandPct": n | null } ],
    "topKlantenError": bool,
    "topArtikelen": [ { "rang": n, "artnr": "...", "omschrijving": "...", "omzet": n, "aantal": n, "aandeelPct": n, "omzetVorigeMaand": n, "vsVorigeMaandPct": n | null } ],
    "topArtikelenError": bool,
    "voorraadBewegingen": {
      "aantalIn": n, "aantalUit": n, "aantalArtikelen": n,
      "topDalers": [ { "rang": n, "artnr": "...", "omschrijving": "...", "netto": n (<0), "aantalBewegingen": n, "huidigeVoorraad": n, "voorraadMin": n } ]
    },
    "voorraadBewegingenError": bool
  }

  voorraadBewegingen: artlog bookings 1st of month through today.
  aantalIn/aantalUit count bookings (aantal > 0 / < 0, incl. beweging "S");
  aantalArtikelen = unique artnr with a non-zero booking. topDalers: max 5
  artikelen with the largest net decrease (excl. beweging "S", excl.
  blokkeren = TRUE / stock = FALSE). Zero summary + empty topDalers with
  voorraadBewegingenError = true when that widget failed.

  topKlanten/topArtikelen: max 5 rows, net omzet excl. BTW this month (credit
  notes netted, voorschot excluded), compared with the same day-range last
  month. Empty array is valid; *Error = true only when that widget's query
  failed (the rest of the response is unaffected).

  Notes:
  - "openOffertesCount"/"openOffertesBedragPotentieel" are latest versie per
    offnr, not passief/verkocht/verloren, AND datum within the last 90 days
    (see DashboardBE class header - older offerte rows are not consistently
    marked closed in production data, so the status flags alone massively
    overcount).
  - "lageVoorraadCount" requires a full scan of ~1.8M artikel rows (no index
    on stock/aantal/minv) and can take 45-70s on a cold cache. The frontend
    caches this endpoint for 60s (Next.js `revalidate`) to avoid paying that
    cost on every dashboard page load - expect the same latency here on a
    cold call from Bruno.
  - "omzetTrend" has 12 monthly data points (the 11 full prior calendar
    months plus the current month, capped at TODAY and flagged
    isPartial: true for the current-month entry). Same revenue rule as
    statCards.omzetDezeMaand (factuur.type EQ TRUE, sum factuur.totaal).
}
