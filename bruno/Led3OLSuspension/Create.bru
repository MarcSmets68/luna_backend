meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/led-3ol-suspension
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "artnr": "#CEILINGBOX or ROSETTE",
    "onderdeel": "P1",
    "ophangpunten": 2,
    "aantal": 4
  }
}

assert {
  res.status: eq 201
  res.body.onderdeel: eq P1
}

docs {
  Creates a led_3OL_suspension row. 404 if artnr isn't found in
  artikel; 409 if the artnr/onderdeel combo already exists. Run
  "Delete" afterwards to clean up test data.
}  
