meta {
  name: Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/web/led-3ol-suspension/%23CEILINGBOX%20or%20ROSETTE/P1
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "ophangpunten": 3
  }
}

assert {
  res.status: eq 200
  res.body.ophangpunten: eq 3
}

docs {
  Partial update - ophangpunten/aantal are writable, artnr/onderdeel
  are immutable. 404 if the row doesn't exist - run "Create" first.
}  
