meta {
  name: ListGeblokkeerdAfterArtnr
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/web/artikel?artnr=%23&geblokkeerd=false&pageSize=10
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("geblokkeerd after artnr does not swallow into the artnr value", function() {
    expect(res.body.items.length).to.be.greaterThan(0);
    res.body.items.forEach(function(i) { expect(i.geblokkeerd).to.equal(false); });
  });
}

docs {
  Regression test: `geblokkeerd` was missing from cKnownParamNames in
  QueryParamHelper, so "&geblokkeerd=false" after another param was
  appended to that param's value (artnr became "#&geblokkeerd=false")
  and returned zero rows. Requires at least one non-blocked artikel
  whose artnr contains "#" in the target database.
}
