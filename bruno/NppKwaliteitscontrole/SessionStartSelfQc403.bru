meta {
  name: SessionStartSelfQc403
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/web/npp/kwaliteitscontrole/{{nppQcSelfAssembledBonnr}}/{{nppQcSelfAssembledGroepnr}}/session
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Auth-Token: {{authToken}}
}

body:json {
  {}
}

assert {
  res.status: eq 403
}

docs {
  POST .../session where the calling user's kode matches
  bon_led(led_lijn=100,lijnnr=7).comp for this bonnr/groepnr (i.e. the
  caller assembled this LVB themselves) - 403 "Je hebt deze LVB zelf
  gemonteerd - zelfcontrole is niet toegestaan".

  {{nppQcSelfAssembledBonnr}}/{{nppQcSelfAssembledGroepnr}} must be set
  to a combination where the logged-in test user is the assembler.
}
