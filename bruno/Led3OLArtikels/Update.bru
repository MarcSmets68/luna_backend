meta {
  name: Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/web/led-3ol-artikels/%23CEILINGBOX%20or%20ROSETTE/P1
  body: json
  auth: none
}

headers {
  Content-Type: application/json
