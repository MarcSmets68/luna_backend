meta {
  name: Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/web/led-3ol-artikels/%23CEILINGBOX%20or%20ROSETTE/P1
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.onderdeel: eq P1
}

docs {
  Gets a single led_3OL_artikels row by artnr/onderdeel (2 path
  segments). 404 if it doesn't exist. Requires the row created by
  "Create" first.
}  
