meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/web/offerte?pageSize=10
  body: none
  auth: none
}

params:query {
  pageSize: 10
  ~klnr:
  ~offgroep:
  ~offnr:
  ~naam:
  ~page:
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists offerte rows (paged), newest offnr/versie first. Query params: klnr
  (exact match), offgroep (exact match), offnr (prefix match on the string
  form, e.g. offnr=12 matches 12, 120, 1234, ...), naam (substring match),
  page (default 1), pageSize (default 25, max 200). Response includes
  hasMore instead of an exact totalCount - see Backend/README.md for why.
  Backed by Backend/src/Luna/Web/OfferteHandler.cls +
  Luna/BusinessLogic/OfferteBE.cls.
}
