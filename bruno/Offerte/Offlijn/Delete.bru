meta {
  name: Delete
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/web/offerte/999999/1/lijn/10
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes an offlijn by offnr+versie+lijnnr. 404 if the parent offerte or
  the line doesn't exist.
}
