meta {
  name: Delete
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/web/offerte/999999/1
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes an offerte by offnr+versie, cascading to every offlijn row under
  it. 404 if it doesn't exist. Run the "Offlijn" requests first if you want
  to exercise the cascade with actual line rows.
}
