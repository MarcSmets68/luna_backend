meta {
  name: Ontvangst
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/web/npp/stockbeweging
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Auth-Token: {{authToken}}
}

body:json {
  {
    "artnr": "{{nppStockArtnr}}",
    "movementType": "ontvangst",
    "aantal": 20,
    "opm": "Levering PO-4821"
  }
}

assert {
  res.status: eq 200
  res.body.artlog.beweging: eq O
  res.body.artlog.aantal: eq 20
}

docs {
  POST /web/npp/stockbeweging - ontvangst: artlog.beweging "O",
  artikel.aantal +aantal, artlog.aantal = +aantal. Requires
  "Auth > Login" to have run first.
}
