meta {
  name: TransferInternMissingMagazijn400
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/web/npp/stockbeweging
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Auth-Token: {{authToken}}
}

body:json {
  {
    "artnr": "{{nppStockArtnr}}",
    "movementType": "transfer_intern"
  }
}

assert {
  res.status: eq 400
  res.body.error.message: eq nieuwMagazijn is verplicht voor transfer intern
}

docs {
  POST /web/npp/stockbeweging - transfer_intern with a missing/blank
  "nieuwMagazijn" - validation step 5, runs before any DB access.
  Requires "Auth > Login" to have run first.
}
