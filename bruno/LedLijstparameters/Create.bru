meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/led-lijstparameters
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "categorie": "TESTCAT",
    "volgnr": 1,
    "artnr": "#CEILINGBOX or ROSETTE",
    "swBegins": true
  }
}

assert {
  res.status: eq 201
  res.body.categorie: eq TESTCAT
}

docs {
  Creates a led_lijstparameters row. 404 if artnr isn't found in
  artikel; 409 if the categorie/volgnr/artnr combo already exists. Run
  "Delete" afterwards to clean up test data.
}  
