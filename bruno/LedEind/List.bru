meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/web/led-eind?pageSize=10
  body: none
  auth: none
}

params:query {
  pageSize: 10
  ~eind:
  ~eindPrefix:
  ~page:
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists led_eind rows (paged). Query params: eind (exact), eindPrefix
  (BEGINS), page (default 1), pageSize (default 25, max 200).
}  
