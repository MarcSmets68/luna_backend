meta {
  name: Get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/web/klant/999999/korting/TESTARTNR
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.artnr: eq TESTARTNR
}

docs {
  Gets a single korting row by klnr+artnr. 404 if it doesn't exist.
  Requires "Create" to have run first.
}
