meta {
  name: Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/web/klant/999999/korting/TESTARTNR
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "korting": 25
  }
}

assert {
  res.status: eq 200
  res.body.korting: eq 25
}

docs {
  Updates the `korting` value only - `artnr` is immutable and `naam` is
  never accepted. `korting` must be numeric and between 0 and 100. 404 if
  the row doesn't exist.
}
