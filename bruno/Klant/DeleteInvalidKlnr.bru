meta {
  name: DeleteInvalidKlnr
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/web/klant/abc
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 400
  res.body.error.message: eq Invalid klnr abc
  res.body.error.code: eq 400
}

docs {
  Regression test for a bug fixed in KlantHandler: a non-numeric {klnr}
  path segment (e.g. "abc") must return 400 "Invalid klnr abc", not fall
  through to a 404 lookup. Standalone request - no setup needed.
}