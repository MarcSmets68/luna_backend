meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/klant
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "klnr": 999999,
    "naam": "Test klant voor CRUD",
    "stad": "Mol",
    "email": "test@example.com"
  }
}

assert {
  res.status: eq 201
  res.body.klnr: eq 999999
}

docs {
  Creates a klant. `klnr` is required (positive integer) and must not already
  exist (409 if it does). Run "Klant - Delete" afterwards to clean up test
  data.
}
