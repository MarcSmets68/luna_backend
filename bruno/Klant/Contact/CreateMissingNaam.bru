meta {
  name: CreateMissingNaam
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/web/klant/999999/contact
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "missing-naam@example.com"
  }
}

assert {
  res.status: eq 400
  res.body.error.message: eq naam is required
  res.body.error.code: eq 400
}

docs {
  400 when naam is missing or blank. Standalone request - no setup/cleanup
  needed (nothing gets created). Requires klnr 999999 to exist - run
  "Klant - Create" first.
}