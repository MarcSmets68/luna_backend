meta {
  name: Delete
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/web/klant/999999/adres/1
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes a klant-adr row by klnr+lijnnr. 404 if it doesn't exist. Does NOT
  auto-promote another row to standaard - zero standaard rows is an
  accepted state.
}
