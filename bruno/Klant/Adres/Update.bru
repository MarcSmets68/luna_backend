meta {
  name: Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/web/klant/999999/adres/1
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "stad": "Testdorp2"
  }
}

assert {
  res.status: eq 200
  res.body.stad: eq Testdorp2
}

docs {
  Partial update - only fields present in the body are changed.
  `klnr`/`lijnnr` are immutable. 404 if the row doesn't exist.
}
