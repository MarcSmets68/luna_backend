meta {
  name: List
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/web/klant/999999/adres
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists klant-adr rows for a klnr, ordered by lijnnr, unpaged (a customer
  typically has a bounded number of addresses). Requires "Create" to have
  run first.
}
