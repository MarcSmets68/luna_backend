meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/web/led-auteur?pageSize=10
  body: none
  auth: none
}

params:query {
  pageSize: 10
  ~artnr:
  ~artnrPrefix:
  ~page:
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists led_auteur rows (paged). Query params: artnr (exact),
  artnrPrefix (BEGINS), page (default 1), pageSize (default 25, max
  200). This table has ~536K rows in production - the filter and page
  window are both pushed down to the ABL query (BEGINS on the unique
  led_auteur-x1 index) by Luna.BusinessLogic.LedAuteurBE, never loading
  the full table into memory.
}  
