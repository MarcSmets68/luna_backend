meta {
  name: Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/web/led-auteur/%23CEILINGBOX%20or%20ROSETTE
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Gets a single led_auteur row by artnr. 404 if it doesn't exist.
  Requires the row created by "Create" first. artnr must be
  URL-encoded (used here: "#CEILINGBOX or ROSETTE", an existing
  artikel row).
}  
