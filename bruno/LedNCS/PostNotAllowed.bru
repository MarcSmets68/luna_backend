meta {
  name: PostNotAllowed
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/led-ncs
  body: json
  auth: none
}

body:json {
  { "ncs": "S0500-N", "omschrijving": "test" }
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 405
}

docs {
  led_NCS is read-only - POST must return 405.
}
