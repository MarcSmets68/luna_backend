meta {
  name: LoginWrongPassword
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/web/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "kode": "ABNA",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq 401
}

docs {
  Wrong password for an existing, active gebruiker - generic 401
  (identical message/body to an unknown kode - no user enumeration,
  see ontwerp paragraaf 1.2.1).
}
