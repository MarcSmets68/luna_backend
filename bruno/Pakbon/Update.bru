meta {
  name: Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/web/pakbon/{{paknr}}
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "opm": "Bijgewerkte opmerking"
  }
}

assert {
  res.status: eq 200
}

docs {
  Partial update of a pakbon.
}

