meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/web/led-technieklever?pageSize=10
  body: none
  auth: none
}

params:query {
  pageSize: 10
  ~laktechniek:
  ~levnr:
  ~page:
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists led_technieklever rows (paged). Query params: laktechniek
  (exact), levnr (exact), page (default 1), pageSize (default 25, max
  200).
}  
