meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/led-technieklever
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "laktechniek": "TSTQ",
    "kleursoort": "TQ",
    "ledType": "Geen",
    "levnr": 1,
    "instelkost": 5.5,
    "kleursupplement": "0.02/m"
  }
}

assert {
  res.status: eq 201
  res.body.laktechniek: eq TSTQ
}

docs {
  Creates a led_technieklever row. `ledType` defaults to "Geen" if
  omitted/blank. 404 if levnr isn't found in lever; 409 if the key
  combo already exists. Run "Delete" afterwards to clean up test data.
}  
