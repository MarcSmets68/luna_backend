meta {
  name: List
  type: http
  seq: 1
}
 
get {
  url: {{baseUrl}}/web/bon?type=ORDERBEVESTIGING&pageSize=10
  body: none
  auth: none
}

params:query {
  pageSize: 10
  type: ORDERBEVESTIGING
  ~klnr:
  ~page:
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists bon (customer order) rows (paged), newest bonnr first. Query params:
  klnr (exact match, 0/absent = no filter), type (exact match, 0/absent = no
  filter), page (default 1), pageSize (default 25, max 200). Response
  includes hasMore instead of an exact totalCount - see Backend/README.md
  for why. Backed by Backend/src/Luna/Web/BonHandler.cls +
  Luna/BusinessLogic/BonBE.cls. Full CRUD is now available for /web/bon -
  see Get/Create/Update/Delete in this folder.
}
