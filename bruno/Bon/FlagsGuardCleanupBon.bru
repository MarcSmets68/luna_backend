meta {
  name: FlagsGuardCleanupBon
  type: http
  seq: 51
}

delete {
  url: {{baseUrl}}/web/bon/{{flagsBonnr}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes the dedicated test bon {{flagsBonnr}}, cleaning up after the
  flags-guard test sequence above. Requires FlagsGuardCleanupLijnPlain
  and FlagsGuardCleanupLijnSubtotaal to have run first (delete 409s while
  any bonlijn row still exists under this bonnr).
}