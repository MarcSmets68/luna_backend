meta {
  name: Get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/web/bon/{{bonnr}}/led/{{ledGroepnr}}/{{ledLijn}}/{{ledLijnnr}}
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Gets a single bon_led row. 404 if not found.
}

