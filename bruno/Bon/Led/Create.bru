meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/web/bon/{{bonnr}}/led
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "groepnr": 1,
    "ledLijn": 1,
    "kode": "TESTKODE",
    "artnr": "TESTART",
    "aantal": 1,
    "lengte": 2.5,
    "siktaKleurKodes": ["RAL9010", "", "", "", ""]
  }
}

assert {
  res.status: eq 201
  res.body.bonnr: eq {{bonnr}}
}

script:post-response {
  bru.setVar("ledGroepnr", res.body.groepnr);
  bru.setVar("ledLijn", res.body.ledLijn);
  bru.setVar("ledLijnnr", res.body.lijnnr);
}

docs {
  Creates a bon_led row. `groepnr`/`ledLijn` are required in the body;
  `lijnnr` is server-generated per bonnr+groepnr+ledLijn. `siktaKleurKodes`
  is a 5-slot array (db extent-5 field) - slot 1 (RAL/SC color code) must
  be non-blank or this 400s (see CreateMissingColor400.bru). Requires
  "Create" (bon) to have run first. Backed by
  Luna.BusinessLogic.BonLedBE.cls.
}

