meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/web/bon/{{bonnr}}/lijn/{{lijnnr}}/productie
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "artnr": "TESTART",
    "aantal": 5,
    "gereserv": 0,
    "besteld": 0,
    "omschr": "Test productie sublijn"
  }
}

assert {
  res.status: eq 201
  res.body.bonnr: eq {{bonnr}}
  res.body.blijnnr: eq {{lijnnr}}
}

script:post-response {
  bru.setVar("plijnnr", res.body.lijnnr);
}

docs {
  Creates a bonlijn_productie sublijn under bonnr/blijnnr {{bonnr}}/
  {{lijnnr}}. `lijnnr` is server-generated (last lijnnr for this
  bonnr+blijnnr + 1). Requires "Create" (bon) and "CreateLijn" to have run
  first. Backed by Luna.BusinessLogic.BonLijnProductieBE.cls.
}

