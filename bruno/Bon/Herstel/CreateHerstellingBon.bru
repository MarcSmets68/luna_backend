meta {
  name: CreateHerstellingBon
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/web/bon
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "type": "HERSTELLING",
    "klnr": 7629,
    "naam": "ZTEST-HERSTEL Klant",
    "munt": "EUR"
  }
}

assert {
  res.status: eq 201
  res.body.type: eq HERSTELLING
}

script:post-response {
  bru.setVar("herstelBonnr", res.body.bonnr);
}

docs {
  Creates a dedicated bon of type HERSTELLING - every endpoint in this
  folder 409s if bon.type NE "HERSTELLING", so this must run first. Run
  "Delete" (Bon folder, using {{herstelBonnr}}) manually afterwards to
  clean up - not automated here to avoid clobbering {{bonnr}} used by the
  rest of the Bon collection.
}

