meta {
  name: UpdateLijnStempelDSetup
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/web/bon/{{stempelDBonnr}}/lijn
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "artnr": "TESTART",
    "omschrijving": "Test regel stempel D",
    "stempel": "D",
    "aantal": 2,
    "vprijs": 50.0
  }
}

assert {
  res.status: eq 201
  res.body.stempel: eq D
}

script:post-response {
  bru.setVar("stempelDLijnnr", res.body.lijnnr);
}

docs {
  Creates a bonlijn with stempel "D" (geleverd) under {{stempelDBonnr}},
  to prove PUT is blocked on delivered lines. Requires
  {{stempelDBonnr}} to be set (run "UpdateLijnStempelDCreateBon" first).
}
