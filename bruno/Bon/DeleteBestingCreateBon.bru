meta {
  name: DeleteBestingCreateBon
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/web/bon
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "type": "TEST",
    "klnr": 7629,
    "naam": "ZTEST-BESTELD",
    "munt": "EUR"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("bestingBonnr", res.body.bonnr);
}

docs {
  Creates a dedicated bon for the "DELETE blocked when a bonlijn has
  besteld <> 0" test sequence below. Stores the new bonnr into
  {{bestingBonnr}}.
}
