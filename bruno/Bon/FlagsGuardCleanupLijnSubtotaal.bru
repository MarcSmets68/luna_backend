meta {
  name: FlagsGuardCleanupLijnSubtotaal
  type: http
  seq: 50
}

delete {
  url: {{baseUrl}}/web/bon/{{flagsBonnr}}/lijn/{{flagsSubtotaalLijnnr}}
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes the subtotaal test bonlijn ({{flagsSubtotaalLijnnr}}) under
  {{flagsBonnr}}, cleaning up after the flags-guard test sequence above.
  Runs before FlagsGuardCleanupBon so {{flagsBonnr}} has zero bonlijn
  rows left when its own delete is attempted (delete 409s while bonlijn
  rows exist).
}