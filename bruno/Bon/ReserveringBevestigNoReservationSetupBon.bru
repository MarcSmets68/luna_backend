meta {
  name: ReserveringBevestigNoReservationSetupBon
  type: http
  seq: 78
}

post {
  url: {{baseUrl}}/web/bon
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "type": "TEST",
    "klnr": 7629,
    "naam": "ZTEST-BEVESTIG-NOOP",
    "munt": "EUR"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("bevestigNoopBonnr", res.body.bonnr);
}

docs {
  Creates a dedicated bon for the "bevestig on a line with gereserv = 0
  is a 200 no-op, not an error" test below. Stores bonnr into
  {{bevestigNoopBonnr}}.
}
