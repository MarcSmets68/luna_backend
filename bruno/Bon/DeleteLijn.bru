meta {
  name: DeleteLijn
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/web/bon/{{bonnr}}/lijn/{{lijnnr}}
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes a bonlijn by bonnr+lijnnr. 404 if it doesn't exist. No cascade -
  bonlijn has no child tables in this scope. Run this before "Delete"
  (bon) in a full-folder run - deleting a bon with bonlijn rows still
  present 409s (see Delete.bru's docs).
}
