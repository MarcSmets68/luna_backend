meta {
  name: HerstellingAutoTransitionBestellen
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/web/bon/{{herstelAutoBonnr}}/herstel/bestellen
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.stempel: eq OND.BESTELD
}

docs {
  Transitions DIAGNOSE -> OND.BESTELD for {{herstelAutoBonnr}} - a
  precondition of Luna.BusinessLogic.BonHerstelBE:
  CheckAutoTransitionToInHerstelling. Requires
  "HerstellingAutoTransitionDiagnose" to have run first.
}
