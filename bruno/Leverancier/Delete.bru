meta {
  name: Delete
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/web/leverancier/{{createdLevnr}}
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes a leverancier by levnr. 404 if it doesn't exist. Uses
  `{{createdLevnr}}` set by "Leverancier - Create" - run Create first to
  clean up test data.
}

