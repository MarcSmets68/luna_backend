meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/leverancier
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "naam": "Test leverancier voor CRUD",
    "stad": "Mol",
    "email": "test@example.com",
    "tekst": "Interne notitie bij aanmaak",
    "btwRegime": 0
  }
}

script:post-response {
  bru.setVar("createdLevnr", res.body.levnr);
}

assert {
  res.status: eq 201
  res.body.levnr: isNumber
  res.body.tekst: eq Interne notitie bij aanmaak
}

docs {
  Creates a leverancier. `levnr` is generated server-side (last existing
  `levnr` + 1) - it is not accepted from the request body; any `levnr`
  sent here is ignored. The generated value is captured into the
  `createdLevnr` variable for use by "Leverancier - Update"/"Leverancier -
  Delete". Run "Leverancier - Delete" afterwards to clean up test data.

  Note: levnrOld, netTel, netFax, btermijn, transport, condities,
  omzhuibj, omzvobj, besteld, klassementmap, dagenLever, banknr, bicnr,
  controleBank are read-only in this API version - they are returned in
  responses but not accepted in the request body (ApplyFields doesn't
  map them yet).
}

