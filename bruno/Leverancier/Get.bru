meta {
  name: Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/web/leverancier/999999
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.levnr: eq 999999
}

docs {
  Gets a single leverancier by levnr. 404 if it doesn't exist. Requires
  levnr 999999 to exist - run "Create" first.

  Response also includes the following read-only `lever` fields (no
  write support via POST/PUT yet - see LeverancierBE.cls ApplyFields):
  levnrOld, netTel, netFax, btermijn, transport, condities, omzhuibj,
  omzvobj, besteld, klassementmap, dagenLever, banknr, bicnr,
  controleBank - plus tekst and btwRegime which were already present.
}

