meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/led-kenmerk
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "kode": "TESTQA1"
  }
}

assert {
  res.status: eq 201
  res.body.kode: eq TESTQA1
}

docs {
  Creates a led_kenmerk row. kode is client-supplied - 409 if it already
  exists. No referential validation (nothing to validate against). Run
  "Delete" afterwards to clean up test data.
}  
