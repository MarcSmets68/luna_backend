meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/web/led-kenmerk?pageSize=10
  body: none
  auth: none
}

params:query {
  pageSize: 10
  ~kode:
  ~kodePrefix:
  ~page:
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists led_kenmerk rows (paged). Query params: kode (exact), kodePrefix
  (BEGINS), page (default 1), pageSize (default 25, max 200).
}  
