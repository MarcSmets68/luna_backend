meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/led-3ol-kodes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "kode": "TESTQAKODE",
    "artnr": "#CEILINGBOX or ROSETTE",
    "comp": "A",
    "excelKode": "EXC1",
    "samenstellingKode": "SAM1"
  }
}

assert {
  res.status: eq 201
  res.body.kode: eq TESTQAKODE
}

docs {
  Creates a led_3OL_kodes row. 404 if artnr isn't found in artikel;
  409 if kode already exists. Run "Delete" afterwards to clean up test
  data.
}  
