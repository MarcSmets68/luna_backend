meta {
  name: Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/web/factuur/9999999/lijn/1
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "aantal": 3
  }
}

assert {
  res.status: eq 200
  res.body.aantal: eq 3
}

docs {
  Partial update - only fields present in the body are changed. `facnr`/
  `lijnnr` are immutable. 404 if the faclijn doesn't exist.
}
