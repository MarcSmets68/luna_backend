meta {
  name: Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/web/factuur/9999999/lijn/1
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Gets a single faclijn by facnr+lijnnr. 404 if not found. Run "Faclijn -
  Create" first.
}
