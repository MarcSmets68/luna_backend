meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/factuur/9999999/lijn
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "lijnnr": 1,
    "artnr": "TESTART",
    "omschrijving": "Test regel voor CRUD",
    "aantal": 2,
    "verkoopprijs": 50.0,
    "bedrag": 100.0
  }
}

assert {
  res.status: eq 201
  res.body.lijnnr: eq 1
}

docs {
  Creates a faclijn under factuur 9999999. `lijnnr` is required (positive
  integer) and must not already exist for this factuur (409 if it does).
  404 if the parent facnr doesn't exist - run "Factuur - Create" first.
  Run "Faclijn - Delete" afterwards to clean up (this also cascades to any
  fac_led test rows created under it).
}
