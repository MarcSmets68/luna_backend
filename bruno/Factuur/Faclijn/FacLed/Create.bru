meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/web/factuur/9999999/lijn/1/led
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "groepnr": 1,
    "ledLijn": 1,
    "artnr": "LEDART",
    "lengte": 1.5,
    "aantal": 4,
    "prijs": 12.5
  }
}

assert {
  res.status: eq 201
  res.body.groepnr: eq 1
  res.body.ledLijn: eq 1
}

docs {
  Creates a fac_led under faclijn 9999999/1. `groepnr` and `ledLijn` are
  required (non-negative integers) and their combination must not already
  exist for this faclijn (409 if it does). 404 if the parent facnr/lijnnr
  doesn't exist - run "Faclijn - Create" first. Run "Fac_led - Delete"
  afterwards to clean up.
}
