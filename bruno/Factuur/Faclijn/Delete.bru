meta {
  name: Delete
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/web/factuur/9999999/lijn/1
  body: none
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq deleted
}

docs {
  Deletes a faclijn by facnr+lijnnr, cascading to every fac_led row under
  it. 404 if it doesn't exist. Run the "Fac_led" requests first if you
  want to exercise the cascade with actual LED-detail rows.
}
