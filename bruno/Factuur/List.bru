meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/web/factuur?pageSize=10
  body: none
  auth: none
}

params:query {
  pageSize: 10
  ~klnr: 
  ~naam: 
  ~datum: 
  ~projectnr: 
  ~page: 
}

headers {
  X-Auth-Token: {{authToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Lists factuur rows (paged), newest datum then facnr first. Query params:
  klnr (exact match), naam (substring match), datum (exact match,
  YYYY-MM-DD), projectnr (exact match), page (default 1), pageSize (default
  25, max 200). Only invoices are returned - factuur.type EQ TRUE is
  hard-coded in Luna.BusinessLogic.FactuurBE, credit notes are never
  included regardless of filters. Response includes hasMore instead of an
  exact totalCount - see Backend/README.md for why. Read-only - backed by
  Backend/src/Luna/Web/FactuurHandler.cls +
  Luna/BusinessLogic/FactuurBE.cls.
}
