meta {
  name: Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/web/factuur/9999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "naam": "Test factuur (bijgewerkt)",
    "swBetaald": true
  }
}

assert {
  res.status: eq 200
  res.body.naam: eq Test factuur (bijgewerkt)
}

docs {
  Partial update - only fields present in the body are changed. `facnr`/
  `type` are immutable/not settable. 404 if the facnr doesn't exist or is
  a credit note.
}
