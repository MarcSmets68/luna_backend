meta {
  name: BerekenHappyPathK5
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/web/btw/bereken
  body: json
  auth: none
}

headers {
  X-Auth-Token: {{authToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "regels": [
      { "btwKode": "3", "bedrag": 100.00, "totaalRecupel": 0 },
      { "btwKode": "1", "bedrag": 50.00, "totaalRecupel": 5.00 }
    ],
    "swRegime": true,
    "swPrijsRecup": true,
    "typeKorting": "K5",
    "documentKortingPercentage": 10,
    "documentKortingBedrag": 0
  }
}

assert {
  res.status: eq 200
  res.body.totaal.regimeToegepast: eq true
  res.body.totaal.totaalBasis: eq 139.5
  res.body.totaal.totBtw: eq 21.87
  res.body.totaal.totaalInclBtw: eq 161.37
  res.body.groepen: length 2
}

docs {
  Worked example from the architect design doc: btw-kode "3" = 21% and
  "1" = 6% in the shared LunaNew test database (NOT literal "21"/"6" -
  see the class header divergence note in BtwBerekeningBE.cls and the
  README's "BTW/VAT engine" section - the design doc's example used the
  percentage value itself as the illustrative kode, but the real
  `btw-kode` table uses short symbolic kodes: "0"=0%, "1"=6%, "2"=12%,
  "3"=21%, "4"=1%). raw basis: 100 (21%-group) + 55 (50 + 5 recupel,
  6%-group) = 155. K5 10% distributed pro-rata by group share -> 90.0/
  49.5 basis, 18.90/2.97 btw -> totaalBasis 139.50, totBtw 21.87,
  totaalInclBtw 161.37. Confirmed live against MarcTest 2026-09-27.
}
